{
  "schema_version": 1,
  "template_scope": "snappy_real",
  "robot_id": "snappy-001",

  "bringup": {
    "mode": "production",
    "allow_partial_devices": false,
    "noop_missing_actuators": false,
    "ignore_device_startup_failures": false,
    "quarantine_failed_devices": false,
    "quarantine_after_failures": 2,
    "quarantine_duration_ms": 2000,
    "arm_requires_all_required_devices": true
  },

  "can_buses": {
    "port_can_0": {
      "backend": "socketcan",
      "interface_name": "can0",
      "bitrate": 1000000,
      "sample_point": 0.833,
      "tx_queue_length": 1000,
      "auto_configure_interface": true,
      "restart_on_bus_off": true,
      "restart_ms": 100,
      "receive_own_messages": false,
      "default_tx_timeout_ms": 20,
      "default_rx_timeout_ms": 20,
      "allow_start_failure": false
    }
  },

  "rs485_ports": {
    "port_usb_rs485_0": {
      "backend": "serial",
      "device_path": "/dev/ttyACM0",
      "baud_rate": 9600,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "inter_frame_gap_ms": 4,
      "read_idle_gap_ms": 4,
      "low_latency": true,
      "shared_lock_group": "usb_rs485_0",
      "shared_transaction_group": "wch_quad_rs485",
      "rs485_direction_mode": "AUTO"
    },
    "port_usb_rs485_1": {
      "backend": "serial",
      "device_path": "/dev/ttyACM1",
      "baud_rate": 9600,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "inter_frame_gap_ms": 4,
      "read_idle_gap_ms": 4,
      "low_latency": true,
      "shared_lock_group": "usb_rs485_1",
      "shared_transaction_group": "wch_quad_rs485",
      "rs485_direction_mode": "AUTO"
    },
    "port_rs485_0": {
      "backend": "serial",
      "device_path": "/dev/ttyS0",
      "baud_rate": 9600,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "inter_frame_gap_ms": 4,
      "read_idle_gap_ms": 4,
      "low_latency": true,
      "shared_lock_group": "board_rs485_0",
      "rs485_direction_mode": "AUTO"
    },
    "port_rs485_3": {
      "backend": "serial",
      "device_path": "/dev/ttyS3",
      "baud_rate": 9600,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "inter_frame_gap_ms": 4,
      "read_idle_gap_ms": 4,
      "low_latency": true,
      "shared_lock_group": "board_rs485_3",
      "rs485_direction_mode": "AUTO"
    }
  },

  "devices": {
    "lidar_brush_left": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_usb_rs485_0",
      "model": "UBS1000-C18R-485",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "ubs1000_c18r",
      "station_id": "0x23",
      "role": "brush_left_distance",
      "poll_interval_ms": 150,
      "response_deadline_ms": 120,
      "max_consecutive_failures": 3,
      "quarantine_duration_ms": 2000,
      "read_retry_count": 1
    },
    "lidar_brush_right": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_usb_rs485_0",
      "model": "UBS1000-C18R-485",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "ubs1000_c18r",
      "station_id": "0x24",
