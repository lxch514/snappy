      "role": "body_right_wind_speed",
      "poll_interval_ms": 200,
      "response_deadline_ms": 120,
      "max_consecutive_failures": 3,
      "quarantine_duration_ms": 2000,
      "read_retry_count": 1
    },
    "wit_motion": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_usb_rs485_1",
      "model": "WTGAHRS02A",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "wit_motion",
      "station_id": "0x65",
      "role": "body_attitude",
      "poll_interval_ms": 200,
      "response_deadline_ms": 120,
      "max_consecutive_failures": 3,
      "quarantine_duration_ms": 2000,
      "read_retry_count": 1
    },

    "temperature_cabinet": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_rs485_3",
      "model": "temperature_humidity_module",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "temperature_humidity",
      "station_id": "0x33",
      "role": "cabinet_environment",
      "poll_interval_ms": 1000,
      "response_deadline_ms": 1500,
      "stale_after_ms": 5000,
      "max_consecutive_failures": 3,
      "quarantine_duration_ms": 2000,
      "read_retry_count": 1
    },
    "power_24v": {
