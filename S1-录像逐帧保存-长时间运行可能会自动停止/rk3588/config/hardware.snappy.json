    "relay_push_motor": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_rs485_0",
      "model": "ZS-DIO-R-10A-4-R-485",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "zs_dio_r_4_relay",
      "station_id": "0x43",
      "channel_count": 4,
      "role": "dual_push_motor_relay",
      "response_deadline_ms": 200,
      "max_consecutive_failures": 3,
      "quarantine_duration_ms": 2000,
      "read_retry_count": 1
    },
    "brush_motor": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_rs485_0",
      "model": "BD-201S",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "bd_201s",
      "station_id": "0x03",
      "role": "brush_roller",
      "response_deadline_ms": 200,
      "max_consecutive_failures": 3,
      "quarantine_duration_ms": 2000,
      "read_retry_count": 1 
    },
    "climber": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_rs485_0",
      "model": "L7P",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "l7p_speed_mode",
      "station_id": "0x02",
      "role": "rope_climber",
      "response_deadline_ms": 300,
      "max_consecutive_failures": 3,
