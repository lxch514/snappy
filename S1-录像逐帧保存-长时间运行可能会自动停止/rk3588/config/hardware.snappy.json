      "model": "KS114",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "ks114",
      "station_id": "0xD2",
      "role": "body_rear_distance",
      "poll_interval_ms": 150,
      "response_deadline_ms": 120,
      "max_consecutive_failures": 3,
      "quarantine_duration_ms": 2000,
      "read_retry_count": 1
    },

    "anemometer_left": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_usb_rs485_1",
      "model": "YN8588B",
      "protocol_family": "modbus_rtu",
      "protocol_profile": "yn8588b",
      "station_id": "0x31",
      "role": "body_left_wind_speed",
      "poll_interval_ms": 200,
      "response_deadline_ms": 120,
      "max_consecutive_failures": 3,
      "quarantine_duration_ms": 2000,
      "read_retry_count": 1
    },
    "anemometer_right": {
      "backend": "real",
      "enabled": true,
      "bus_id": "port_usb_rs485_1",
      "model": "YN8588B",
