[Unit]
Description=Snappy optional packet capture
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/snappy/snappy-diagnostics.env
Environment=SNAPPY_LOG_DIR=/var/log/snappy
Environment=SNAPPY_CAPTURE_DIR=/var/log/snappy/captures
Environment=SNAPPY_CAPTURE_SECONDS=120
Environment=SNAPPY_CAPTURE_IFACE=any
Environment=SNAPPY_CAN_IFACE=can0
ExecStartPre=-/bin/mkdir -p /var/log/snappy/captures
ExecStartPre=-/bin/chmod +x /opt/snappy/tools/snappy_packet_capture.sh
ExecStart=/opt/snappy/tools/snappy_packet_capture.sh all

[Install]
WantedBy=multi-user.target