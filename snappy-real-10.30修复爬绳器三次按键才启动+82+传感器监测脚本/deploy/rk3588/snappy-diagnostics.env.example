# Snappy diagnostics runtime configuration

SNAPPY_LOG_DIR=/var/log/snappy
SNAPPY_DIAG_DIR=/var/log/snappy/diagnostics
SNAPPY_CAPTURE_DIR=/var/log/snappy/captures
SNAPPY_CORE_DIR=/var/coredump/snappy

# info or debug; debug records every G20 raw channel packet in the gateway log
SNAPPY_LOG_LEVEL=debug

# 0: normal logs only
# 1: record RS485/CAN/UDP packet hex dumps in snappy-control/snappy-gateway logs
SNAPPY_PACKET_TRACE=0

# manual packet capture options
SNAPPY_CAPTURE_SECONDS=120
SNAPPY_CAPTURE_IFACE=any
SNAPPY_CAN_IFACE=can0

# G20 command/status/telemetry + RTP video ports
SNAPPY_UDP_FILTER="udp port 14550 or udp port 14551 or udp port 14552 or udp port 5600 or udp port 5602"
